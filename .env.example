# 复制这个文件为 .env，填入真实 key。.env 已在 .gitignore 中，不会被提交。
# DeepSeek 控制台：https://platform.deepseek.com/api_keys

DEEPSEEK_API_KEY=sk-xxx

# 模型：别名或完整名均可，CLI --model 可覆盖（模型注册表见 src/run_eval.py 的 MODELS）
#   v4-flash            deepseek-v4-flash            默认，DeepSeek-V4-Flash-0731
#   v4-pro              deepseek-v4-pro              DeepSeek-V4-Pro-0813，价格约 3 倍
#   v4-flash-vision     deepseek-v4-flash-vision-exp 实验版多模态
#   v4.1-flash-beta     deepseek-v4.1-flash-expires-on-0910
#                       限时内测（2026-09-08 官方群宣布），⚠ 09-10 过期，20 并发
#   chat / reasoner     deepseek-chat / deepseek-reasoner
#                       已废弃别名（= v4-flash 非/思考模式），随时可能停用
# DEEPSEEK_MODEL=deepseek-v4-flash

# v4 系默认开思考模式且忽略 temperature；要 temperature 生效必须显式关思考
# EVAL_THINKING=disabled
# EVAL_TEMPERATURE=0
# 思考档位，仅 EVAL_THINKING=enabled 时生效：low | high | max
# EVAL_REASONING_EFFORT=low

# DEEPSEEK_BASE_URL=https://api.deepseek.com
