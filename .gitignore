# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 密钥
.env
.env.*
*.key
# 例外：模板本身要进仓库，否则别人 clone 下来不知道要填什么
!.env.example

# 评测结果（原始输出可能含敏感内容，按需决定是否提交）
# runs/
# reports/

# 私人材料（求职 / 个人事务，不进本仓库）
# 判据：只提交与项目有关的文件
.workbuddy/
docs/求职策略-*
docs/疑问清单-*
research/调研-*
research/岗位调研-*

# WorkBuddy 发布应用的本地标记文件（本地产物，非项目资产）
.wbapp_*.genie

# 草稿区（AGENTS.md 里 .scratch/ 是本地 issue / 临时脚本的家）
# 需要留下的工具脚本请提升到 src/（例：build_review_pack.py）
.scratch/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 语料生成物（由 src/fetch_corpus.py 重建，不要手改）
research/corpus/CORPUS.md
research/corpus/resolved/
research/corpus/_src/
